# ─── DATABASE ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/portucale_dental

# ─── JWT ─────────────────────────────────────────────────────
# Gerar com: openssl rand -base64 48
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_TTL_SECONDS=604800

# ─── R2 / S3 (opcional — fallback para local storage) ───────
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_BUCKET=<bucket-name>
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=

# ─── WHATSAPP (opcional) ─────────────────────────────────────
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=appointment_reminder
# WHATSAPP_TEMPLATE_LANG=en_US

# ─── UPLOADS ─────────────────────────────────────────────────
# UPLOAD_RETENTION_DAYS=90
